# Required: Bot token from @BotFather
# Either name works (TELEGRAM_BOT_TOKEN preferred).
TELEGRAM_BOT_TOKEN=
# TELEGRAM_TOKEN=

# Optional: your chat id for smoke tests / proactive pings
# TELEGRAM_CHAT_ID=
# CHAT_ID=

# Optional: OpenAI-compatible API for AI mystic replies.
# When unset, the bot uses high-quality scripted psychic replies.
#
# Groq (recommended simple path):
#   GROQ_API_KEY=gsk_...
#   (defaults OPENAI_BASE_URL to https://api.groq.com/openai/v1
#    and OPENAI_MODEL to openai/gpt-oss-20b)
# Or any OpenAI-compatible provider:
OPENAI_API_KEY=
# GROQ_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional tuning
LOG_LEVEL=INFO
BOT_DISPLAY_NAME=Projekt212 Oracle
